# Placeholders only. Set real values in Railway / Vercel / n8n — never commit secrets.
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# Supabase (project carstudio-ai, Mumbai). Use the *pooler* connection string from
# Supabase → Project Settings → Database → Connection string → Transaction pooler.
DATABASE_URL=postgresql+psycopg://postgres.hmzabavkeibcqyzgwjzz:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
REDIS_URL=redis://localhost:6379/0
SUPABASE_URL=https://hmzabavkeibcqyzgwjzz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SECRET
STORAGE_ORIGINALS_BUCKET=car-originals
STORAGE_OUTPUTS_BUCKET=car-results

# Image providers, tried left to right. Available: fal_flux_kontext, vertex_gemini, gemini_paid, gemini_free, local_composite
IMAGE_PROVIDER_CHAIN=fal_flux_kontext,vertex_gemini,gemini_paid,gemini_free,local_composite
# Google Cloud API key with Vertex AI API enabled — billed to the GCP account, so cloud credits apply.
VERTEX_API_KEY=SECRET
FAL_KEY=SECRET
FAL_MODEL=fal-ai/flux-pro/kontext
GEMINI_PAID_API_KEY=SECRET
GEMINI_FREE_API_KEY=SECRET
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VISION_MODEL=gemini-2.5-flash
VISION_ENABLED=true
# Consent versions whose wording tells customers free-tier providers may use images for training.
# Leave empty to never send customer photos to a free tier.
FREE_TIER_CONSENT_VERSIONS=

PRICE_FAL_FLUX_KONTEXT=0.04
PRICE_GEMINI_PAID=0.039
PRICE_GEMINI_VISION=0.002
MONTHLY_SPEND_LIMIT_USD=5

N8N_INTERNAL_API_TOKEN=SECRET
N8N_CALLBACK_URL=https://YOUR_N8N/webhook/carstudio-job-events
N8N_CALLBACK_HMAC_SECRET=SECRET
CUSTOMER_HASH_SALT=SECRET
ADMIN_API_TOKEN=SECRET

SENTRY_DSN=
MAX_UPLOAD_MB=15
MAX_GENERATION_ATTEMPTS=3
DAILY_ANONYMOUS_QUOTA=2
DAILY_CUSTOMER_QUOTA=10
IMAGE_RETENTION_DAYS=30
STYLES=white_studio,dark_luxury,showroom
